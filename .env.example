# amazee-llm-proxy configuration. Copy to .env and edit:  cp .env.example .env
# Nothing is REQUIRED: the defaults below give a working loopback-only proxy.

# ---- Network (change if the port clashes) ----
# Host interface the published port binds to. 127.0.0.1 = this machine only (recommended).
# Use 0.0.0.0 ONLY behind a firewall/reverse proxy AND with AMAZEE_PROXY_API_KEY set.
BIND_IP=127.0.0.1
# Host port to publish.
HOST_PORT=8127

# ---- Security (OPTIONAL, strongly recommended if reachable by anything but you) ----
# If set, clients must send:  Authorization: Bearer <this value>
AMAZEE_PROXY_API_KEY=

# ---- Key pool tuning (OPTIONAL) ----
# Live trial keys kept on standby (each trial key has a ~$2 budget).
AMAZEE_PROXY_MIN_STANDBY=5
# Background standby top-up (1 = on, 0 = off) and its check interval in seconds.
AMAZEE_PROXY_TOPUP=1
AMAZEE_PROXY_TOPUP_INTERVAL=30
# Max different keys tried for one request before giving up with 502.
AMAZEE_PROXY_KEYS_PER_REQUEST=3
# Seconds a key is paused after an upstream 429.
AMAZEE_PROXY_COOLDOWN_S=120
# Seconds /v1/models is cached.
AMAZEE_PROXY_MODELS_TTL=600
